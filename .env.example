# Copy to .env and fill in. .env is git-ignored; never commit real values.

# Schwab developer app (https://developer.schwab.com). Needed only for data = "schwab" or live mode.
SCHWAB_CLIENT_ID=
SCHWAB_CLIENT_SECRET=
# Must exactly match the callback URL registered on your Schwab app.
SCHWAB_REDIRECT_URI=https://127.0.0.1:8182
# Only needed if several accounts are linked to your login.
SCHWAB_ACCOUNT_NUMBER=
# Where OAuth tokens are stored (created with owner-only permissions).
OPTIONDESK_TOKEN_PATH=~/.optiondesk/schwab_tokens.json

# Require this key on the dashboard and API. Strongly recommended if the
# dashboard is reachable from anywhere but your own machine.
OPTIONDESK_API_KEY=

# Live trading guard. Leave empty. Set to exactly "yes-i-understand" only when
# mode = "live" and you accept that real orders will be placed.
OPTIONDESK_LIVE_TRADING=
